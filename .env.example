# =================================================================
# TerraAI — AI-Powered Sustainable Smart City Planning Platform
# Environment Configuration & Indian Space Portal Credentials
# =================================================================

PROJECT_NAME="TerraAI Geospatial Platform"
VERSION="1.0.0"
API_V1_STR="/api"

# Set to True to operate in transparent calibrated demo mode (authoritative cached datasets)
# Set to False to enforce live authenticated HTTP calls to external portals
DEMO_MODE=True

# -----------------------------------------------------------------
# 1. ISRO BHOONIDHI (NRSC) — Earth Observation STAC Catalog
# Docs: https://bhoonidhi.nrsc.gov.in/bhoonidhi-api/
# -----------------------------------------------------------------
BHOONIDHI_API_KEY=""
BHOONIDHI_TOKEN=""
BHOONIDHI_BASE_URL="https://bhoonidhi.nrsc.gov.in/bhoonidhi-api"

# -----------------------------------------------------------------
# 2. ISRO BHUVAN (NRSC) — Thematic Layers & Vector WMS
# Docs: https://bhuvan-app1.nrsc.gov.in/api/
# -----------------------------------------------------------------
BHUVAN_TOKEN=""
BHUVAN_BASE_URL="https://bhuvan-app1.nrsc.gov.in/api"
BHUVAN_WMS_URL="https://bhuvan-vec2.nrsc.gov.in/bhuvan/wms"

# -----------------------------------------------------------------
# 3. ISRO MOSDAC (SAC) — Satellite Meteorology & INSAT-3D/3DR
# Portal: https://mosdac.gov.in/
# -----------------------------------------------------------------
MOSDAC_USER=""
MOSDAC_TOKEN=""
MOSDAC_BASE_URL="https://mosdac.gov.in/api"

# -----------------------------------------------------------------
# 4. ISRO VEDAS (SAC) — Vegetation & Solar/Wind Screening
# Portal: https://vedas.sac.gov.in/ | Console: https://www.vedas.sac.gov.in/vconsole/
# -----------------------------------------------------------------
VEDAS_TOKEN=""
VEDAS_BASE_URL="https://vedas.sac.gov.in/vconsole/api"
VEDAS_WMS_URL="https://vedas.sac.gov.in/wms"

# -----------------------------------------------------------------
# Additional Authoritative Feeds (Optional)
# -----------------------------------------------------------------
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal/climatology/point"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
