# TerraAI — Environment Configuration
# API Credentials for Indian Space Portals & AI Models

# 1. ISRO / NRSC Bhoonidhi Open STAC API
# Register & obtain at: https://bhoonidhi.nrsc.gov.in/
BHOONIDHI_API_KEY=
BHOONIDHI_CLIENT_ID=
BHOONIDHI_CLIENT_SECRET=

# 2. ISRO / NRSC Bhuvan Geospatial Services
# Register at: https://bhuvan-app1.nrsc.gov.in/api/
BHUVAN_API_KEY=
BHUVAN_TOKEN=

# 3. ISRO / SAC MOSDAC Weather & Meteorological Satellite Data
# Register at: https://mosdac.gov.in/
MOSDAC_USER=
MOSDAC_KEY=

# 4. ISRO / SAC VEDAS Vegetation & Environmental Platform
# Register at: https://www.vedas.sac.gov.in/vconsole/
VEDAS_API_KEY=

# 5. AI Planning Assistant LLM (Optional — Falls back to native deterministic expert planner)
GEMINI_API_KEY=
OPENAI_API_KEY=

# 6. System Runtime Mode
# When set to True, TerraAI uses authentic verified sample datasets for Indian benchmark sites
# when live space portal credentials are not yet configured.
DEMO_MODE=True
