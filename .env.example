# TerraCity AI Environment Configuration
# Copy this file to .env and configure as needed

# --- ISRO / Indian Space Portals ---
# Bhoonidhi (NRSC/ISRO)
BHOONIDHI_USER=
BHOONIDHI_PASSWORD=

# MOSDAC (SAC/ISRO)
MOSDAC_USER=
MOSDAC_PASSWORD=

# VEDAS (SAC/ISRO)
VEDAS_API_KEY=

# Bhuvan (NRSC/ISRO)
BHUVAN_USER=
BHUVAN_PASSWORD=

# --- Optional LLM Narration ---
LLM_PROVIDER=gemini   # gemini | openai (optional)
LLM_API_KEY=          # optional API key for guarded narrative explanation
LLM_BASE_URL=         # optional, for OpenAI-compatible custom endpoints
LLM_MODEL=gemini-2.5-flash

# --- Data & Offline Pipeline ---
DATA_DIR=./data
OFFLINE_MODE=true     # Set true for 100% offline demonstration using regional caches/fixtures

# --- Server Configuration ---
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# --- CARTO Basemap API ---
VITE_CARTO_API_KEY=
